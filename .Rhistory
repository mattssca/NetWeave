parse_ihc_status <- function(ihc_code) {
ihc_code <- trimws(ihc_code)
status <- case_when(
ihc_code == "T"              ~ "IHC_agrees",
str_detect(ihc_code, "^O")  ~ "IHC_disagrees",
ihc_code == "N"              ~ "no_IHC",
TRUE                         ~ NA_character_
)
# Extract the IHC subtype if present (e.g. "O BaSq" -> "BaSq")
ihc_subtype <- if_else(
str_detect(ihc_code, "^O "),
str_extract(ihc_code, "\\S+$"),
NA_character_
)
tibble(IHC_status = status, IHC_subtype = ihc_subtype)
}
