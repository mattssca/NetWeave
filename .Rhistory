#load netweave
devtools::load_all("../../NetWeave/")
#source function
source("functions/plot_survival_by_expression.R")
source("functions/plot_expression_rank.R")
source("functions/save_figure.R")
#load data
sjodahl_expr = sjodahl_2017
sjodahl_meta = sjodahl_2017_meta
sjodahl_meta$subtype <- sjodahl_2017_subtypes[sjodahl_meta$sample_id]
#load pacakges
library(survival)
library(survminer)
#subset data
sjodahl_meta_subset   <- sjodahl_meta[sjodahl_meta$subtype %in% c("Uro", "GU", "BaSq"), ]
rownames(sjodahl_meta_subset) <- sjodahl_meta_subset$sample_id
#plot expression rank
ctnnb1_ranked_expression_cut = plot_expression_rank(
expr_data     = sjodahl_expr,
metadata      = sjodahl_meta_subset,
gene          = "CTNNB1",
subtype_col   = "subtype",
subtypes      = c("Uro", "GU", "BaSq"),
split_by = "quantile",
high_quantile = 0.8,
scale = TRUE
)
save_figure(plot = ctnnb1_ranked_expression_cut,
filename = "figures/08_ctnnb1_survival/out/08_ctnnb1_ranked_expression_cut",
width = 10,
height = 4,
dpi = 300)
setwd("~/BIOINFORMATICS/GIT_HUB/NetWeave")
devtools::document()
