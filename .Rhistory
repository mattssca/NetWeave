metadata        = uro_a_samples,
sample_order    = colnames(uro_a_pred$data),   # now ordered by group
annotation_vars = "group",
show_legends    = TRUE,
custom_colors   = list(group = c("1" = "#F26076", "2" = "#458B73", "3" = "#FFD150", "4" = "#FF9760"))
)
