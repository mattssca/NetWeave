# ── helper: order samples by group, re-order all prediction objects ────────────
order_by_group <- function(pred, metadata) {
# get sample names in current order
sample_names <- colnames(pred$data)
# get group for each sample and sort
groups <- metadata$group[match(sample_names, metadata$sample_id)]
ordered_names <- sample_names[order(groups)]
# re-order all elements of the predictions object
pred$data                 <- pred$data[, ordered_names]
pred$predictions_5classes <- pred$predictions_5classes[ordered_names]
pred$predictions_7classes <- pred$predictions_7classes[ordered_names]
pred$subtype_scores       <- pred$subtype_scores[ordered_names, ]
pred$scores               <- pred$scores[ordered_names, ]
return(pred)
}
uro_a_pred <- order_by_group(uro_a_pred, uro_a_samples)
uro_b_pred <- order_by_group(uro_b_pred, uro_b_samples)
gu_pred    <- order_by_group(gu_pred,    gu_samples)
# ── create cluster annotations ─────────────────────────────────────────────────
