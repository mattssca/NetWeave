library(tidyr)
library(dplyr)
library(stringr)
parse_run_result <- function(code, true_label) {
code <- trimws(code)
# Determine status
no_diag    <- str_detect(code, "^N ")
correct    <- str_detect(code, "^R|^RC")
contested  <- str_detect(code, "C ")
wrong      <- str_detect(code, "^W|^WC")
raw_r      <- code == "R"
status <- case_when(
raw_r   ~ "correct",
no_diag ~ "no_diagnosis",
correct ~ "correct",
wrong   ~ "wrong",
TRUE    ~ NA_character_
)
# Extract reported subtype (last token)
reported_subtype <- str_extract(code, "\\S+$")
if (reported_subtype %in% c("R")) reported_subtype <- true_label
tibble(
status           = status,
contested        = contested,
reported_subtype = reported_subtype
)
}
