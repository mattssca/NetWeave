parse_ihc_status <- function(ihc_code) {
case_when(
ihc_code == "T" ~ "IHC_agrees",
ihc_code == "O" ~ "IHC_disagrees",
ihc_code == "N" ~ "no_IHC",
TRUE            ~ NA_character_
)
}
